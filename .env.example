# Required in production
DATABASE_URL=postgres://user:pass@host:6543/postgres
JWT_SECRET=generate-with-openssl-rand-hex-32
# File storage (Supabase). Without these, files go to ./.data in local development only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=
STORAGE_BUCKET=cleared-uploads
# Automatic extraction. Without a key every shipment goes straight to a reviewer.
ANTHROPIC_API_KEY=
# Code delivery. Without these, production refuses to send codes.
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
# Optional
FREE_ORDERS=10
PER_SHIPMENT_FEE_PKR=3000
